    <string name="tutorial_1_title">Equal numbers</string>
    <string name="tutorial_1_text">Two equal numbers that touch are a pair. Match the two 5s.</string>
    <string name="tutorial_2_title">Add up to 10</string>
    <string name="tutorial_2_text">Two numbers that add up to 10 are a pair too, and up and down counts. Match the 4 and the 6.</string>
    <string name="tutorial_3_title">Diagonals</string>
    <string name="tutorial_3_text">Numbers touching on a diagonal count too. Match the 2 and the 8.</string>
    <string name="tutorial_4_title">Long shot</string>
    <string name="tutorial_4_text">With only cleared cells between them, numbers still connect, and it\'s worth more: 4 points. Match the 7 and the 3.</string>
    <string name="tutorial_5_title">Next row</string>
    <string name="tutorial_5_text">The board reads like a page: the end of a row connects to the start of the next. Match the 9 and the 1.</string>
    <string name="tutorial_6_title">Clear a row</string>
    <string name="tutorial_6_text">Empty a whole row and it goes away, for 10 points. Match the last two 6s.</string>
    <string name="tutorial_7_title">Out of pairs?</string>
    <string name="tutorial_7_text">No pairs left. Tap + to copy the numbers left to the end of the board. You get 5 per board.</string>
