<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_background">#0F1A1D</color>
    <style name="Theme.QuietNumbers" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
    <!-- System splash (SplashScreen API): the background only; Compose draws the lockup after it. -->
    <style name="Theme.QuietNumbers.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.QuietNumbers</item>
    </style>
</resources>
